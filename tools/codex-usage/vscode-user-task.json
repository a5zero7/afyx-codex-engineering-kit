{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Codex: Watch Token Usage",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${env:USERPROFILE}\\.codex\\tools\\codex-usage-watch.ps1"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
