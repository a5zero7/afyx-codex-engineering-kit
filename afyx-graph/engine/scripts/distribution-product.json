{
  "productName": "Afyx Graph",
  "packageName": "@a5zero7/afyx-graph",
  "cli": "afyx-graph",
  "bundlePrefix": "afyx-graph",
  "runtime": {
    "name": "Node.js",
    "ownership": "external_platform",
    "executable": "node",
    "minimumVersion": "22.5.0"
