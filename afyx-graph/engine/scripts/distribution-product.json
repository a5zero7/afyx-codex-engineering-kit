  "targets": [
    "darwin-arm64",
    "darwin-x64",
    "linux-arm64",
    "linux-x64",
    "win32-arm64",
    "win32-x64"
  ],
  "engineSentinels": [
    "bin/afyx-graph.js",
    "index.js",
    "ui/shimmer-progress.js"
  ],
  "legalFiles": [
    {
      "source": "LICENSE",
      "bundlePath": "LICENSE"
    }
  ]
}
